DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
JWT_SECRET=""
# Docker Compose database configuration (choose your own password).
POSTGRES_USER="proptech"
POSTGRES_PASSWORD=""
POSTGRES_DB="proptech_db"
POSTGRES_PORT="5432"
# Same credentials as DATABASE_URL; use db as the host inside Docker.
DOCKER_DATABASE_URL="postgresql://USER:PASSWORD@db:5432/DATABASE?schema=public"

# Development only: private local credential delivery sink (never enabled in production).
DEV_CREDENTIAL_LINKS=0
APP_ORIGIN=http://localhost:3000
# Production credential email: verified sender/domain and HTTPS public origin required.
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=

# Production container entrypoint requires all above email settings, a random
# JWT_SECRET (32+ characters), HTTPS APP_ORIGIN, and DATABASE_URL sslmode=require
# &sslaccept=strict, with sslcert=/PRIVATE/provider-ca.pem if provider requires a CA.
# Bound pool size per replica: append connection_limit=5&pool_timeout=10.
STORAGE_BACKEND=local
# Production: persistent, absolute private mount, e.g. /app/storage/uploads.
UPLOAD_ROOT=
# Production Compose interpolation settings; keep real values outside Git.
APP_IMAGE=
OPS_IMAGE=
PRODUCTION_ENV_FILE=
UPLOAD_VOLUME=
LEGACY_UPLOAD_PATH=
TLS_CERT_PATH=
PUBLIC_HOSTNAME=
DATABASE_CA_PATH=
