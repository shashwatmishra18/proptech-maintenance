generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TENANT
  MANAGER
  TECHNICIAN
}

enum Status {
  OPEN
  ASSIGNED
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  unitId String?
  unit Unit? @relation("Occupants", fields: [unitId], references: [id], onDelete: Restrict)
  occupancyVersion Int @default(0)
  properties Property[]

  ticketsAsTenant Ticket[] @relation("TenantTickets")
  ticketsAssigned Ticket[] @relation("AssignedTickets")

  activityLogs  ActivityLog[]
  notifications Notification[]
  @@index([unitId])
}

model Ticket {
  id          String   @id @default(uuid())
  title       String
  description String
  status      Status   @default(OPEN)
  priority    Priority @default(MEDIUM)
  propertyId String?
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unitId String?
  unit Unit? @relation(fields: [unitId, propertyId], references: [id, propertyId], onDelete: Restrict)
  
  tenantId    String
  tenant      User     @relation("TenantTickets", fields: [tenantId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("AssignedTickets", fields: [assignedToId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images       TicketImage[]
  activityLogs ActivityLog[]
  @@index([propertyId])
}

model Property {
  id String @id @default(uuid())
  name String
  address String
  description String?
  managerId String
  manager User @relation(fields: [managerId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  units Unit[]
  tickets Ticket[]
  @@index([managerId])
}

model Unit {
  id String @id @default(uuid())
  identifier String
  floor String?
  description String?
  propertyId String
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenants User[] @relation("Occupants")
  tickets Ticket[]
  @@unique([propertyId, identifier])
  @@unique([id, propertyId])
}

model TicketImage {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  imageUrl String
}

model ActivityLog {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
